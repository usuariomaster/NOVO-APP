# ============================================================
# Configuração do SisPerícia — copie para ".env" e ajuste
# ============================================================

# Porta do servidor web
PORT=3000

# Chave secreta usada para sessões e para criptografar as
# credenciais do SEI guardadas no banco. TROQUE por um valor
# aleatório e longo em produção.
APP_SECRET=troque-esta-chave-por-um-valor-aleatorio-e-longo

# ------------------------------------------------------------
# SEI — Nova Iguaçu
# ------------------------------------------------------------
# URL base do SEI (sem barra no final)
SEI_BASE_URL=https://sei.novaiguacu.rj.gov.br/sei

# Órgão/Sigla que aparece na tela de login do SEI (se houver
# seletor de órgão). Deixe em branco se o login não pedir órgão.
SEI_ORGAO=

# Modo simulação: com "true" o robô NÃO acessa o SEI de verdade
# e devolve processos de exemplo. Serve para testar o sistema
# inteiro sem credenciais. Coloque "false" para usar o SEI real.
SEI_MOCK=true

# Rodar o navegador do robô com janela visível (true) para
# depurar o login, ou invisível/headless (false) em produção.
SEI_HEADFUL=false

# As credenciais de login no SEI (usuário/senha por unidade)
# NÃO ficam aqui — são cadastradas com segurança dentro do
# próprio sistema, na tela de Configuração do SEI (perfil admin).
